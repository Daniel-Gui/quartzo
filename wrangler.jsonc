{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "quartzo",
	"compatibility_date": "2026-02-18",
	"compatibility_flags": ["nodejs_als"],
	// Wrapper around the SvelteKit worker; see worker.js and wrangler.adapter.jsonc.
	"main": "worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true
}
